DATABASE_URL=mysql+pymysql://stock:stockledger123@127.0.0.1:3306/stock_ledger
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUOTE_CACHE_SECONDS=60
BENCHMARK_SYMBOL=QQQ
# Required by POST /api/news/ingest. Generate a long random value and share it only with Grok Bot.
NEWS_INGEST_TOKEN=
# Held stocks are precomputed once per minute while their exchange is open.
INDICATOR_MONITOR_ENABLED=true
INDICATOR_MONITOR_SECONDS=60
# DingTalk custom group robot. SECRET is optional when the robot does not require signing.
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# true = refresh quotes. US uses YFinance; A-share/HK use AkShare, then the fallbacks below.
MARKET_REFRESH_ENABLED=true

# AkShare is the default for A-shares and Hong Kong. No token.
# Baostock is the free A-share backup when AkShare returns nothing.
# US live quotes try Sina, then Tencent. Yahoo fills whatever those missed. Daily bars still try Yahoo first.

# Eastmoney (AkShare) often drops connections. When logs show RemoteDisconnected or push2his.eastmoney.com:
# ENABLE_EASTMONEY_PATCH=true
# MAX_WORKERS=1
ENABLE_EASTMONEY_PATCH=false
MAX_WORKERS=4

# Longbridge fills US quotes only when YFinance is incomplete, and HK quotes only when AkShare is incomplete.
# It is not used for A-shares. Leave these empty to skip the client entirely.
# Prefer OAuth: set LONGBRIDGE_OAUTH_CLIENT_ID, then in an interactive shell run
#   python scripts/generate_longbridge_oauth_token.py --client-id <client_id>
# Headless hosts cannot open that browser. Base64 the local file
# ~/.longbridge/openapi/tokens/<client_id> into LONGBRIDGE_OAUTH_TOKEN_CACHE_B64.
# If LONGBRIDGE_OAUTH_CLIENT_ID is empty and no legacy access token is set, LONGBRIDGE_APP_KEY is used as the client id.
# Legacy API key (not an OAuth access token): LONGBRIDGE_APP_KEY, LONGBRIDGE_APP_SECRET, LONGBRIDGE_ACCESS_TOKEN.
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# LONGBRIDGE_HTTP_URL=
# LONGBRIDGE_QUOTE_WS_URL=
# LONGBRIDGE_TRADE_WS_URL=
# LONGBRIDGE_REGION=
