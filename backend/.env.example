DATABASE_URL=mysql+pymysql://stock:stockledger123@127.0.0.1:3306/stock_ledger
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUOTE_CACHE_SECONDS=60
BENCHMARK_SYMBOL=QQQ
# true = refresh US quotes through global-stock-data providers (Sina/Tencent)
MARKET_REFRESH_ENABLED=true

# Vibe-Trading runs as an independent service: vibe-trading serve --port 8899
VIBE_TRADING_URL=http://127.0.0.1:8899
# Set this to the same API_AUTH_KEY configured in Vibe-Trading when enabled.
VIBE_TRADING_API_KEY=
VIBE_TRADING_TIMEOUT_SECONDS=300
